{
  "name": "earth-farm-bot",
  "version": "0.0.6",
  "description": "Discord farming game bot - plant crops, raise animals, and trade with friends!",
  "keywords": [
    "discord",
    "bot",
    "farming",
    "game"
  ],
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "bot": "bun run index.ts",
    "dev": "bun run --watch index.ts",
    "start": "bun run index.ts",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "canvas": "^3.1.0",
    "discord.js": "^14.17.3",
    "mongoose": "^8.9.6",
    "node-cache": "^5.1.2"
  }
}