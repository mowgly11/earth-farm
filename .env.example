# =================================
# Earth Farm Bot - Environment Variables
# =================================
# Copy this file to .env and fill in your values

# Discord Bot Credentials
# Get these from https://discord.com/developers/applications
token=YOUR_BOT_TOKEN_HERE
clientId=YOUR_APPLICATION_ID_HERE
GUILD_ID=YOUR_GUILD_ID_HERE

# Discord Channel IDs for Logging
# Create channels in your server and copy their IDs
COMMANDS_LOG_CHANNEL_ID=YOUR_CHANNEL_ID
TRANSACTION_LOG_CHANNEL_ID=YOUR_CHANNEL_ID
ERROR_LOG_CHANNEL_ID=YOUR_CHANNEL_ID
INTERACTION_LOG_CHANNEL_ID=YOUR_CHANNEL_ID  # Optional - for button/select interaction logs

# MongoDB Connection
# Get this from https://cloud.mongodb.com/
mongo_connection=mongodb+srv://username:password@cluster.mongodb.net/database

# Admin Configuration
# Your Discord user ID (right-click your profile → Copy User ID)
ADMIN_USER_ID=YOUR_DISCORD_USER_ID